# Supabase — crea un proyecto en https://supabase.com y copia estos valores
# desde Project Settings → API. Mientras estén vacíos, la app corre con los
# datos semilla de src/lib/data/seed.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de servidor (seed, migraciones). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres local del compose (docker compose up). No se usa todavía:
# la app corre con datos semilla hasta que conectemos la capa de datos.
DATABASE_URL=postgres://velie_app:velie_app@db:5432/velie

# Puertos que expone el compose en tu máquina (cámbialos si chocan con algo).
APP_PORT=3000
DB_PORT=5433

# Consulta de patentes — https://docs.boostr.cl/reference/car-plate
# Sin esta clave se usa el endpoint de prueba, que devuelve datos de ejemplo.
BOOSTR_API_KEY=

# Proveedor de datos de patente: fixtures | boostr | autoriesgo
# Sin definir: usa el primero que tenga clave, o los datos de ejemplo.
PROVEEDOR_PATENTE=
AUTORIESGO_API_KEY=

# Clave maestra para cifrar credenciales de terceros guardadas por cada
# automotora. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Generación de imágenes para el Estudio.
# Estas claves son de la PLATAFORMA: costean la biblioteca de fondos compartida.
#
# Gemini es el proveedor por defecto. La clave sale de https://aistudio.google.com/apikey
# y necesita facturación activa: la generación de imágenes no tiene capa gratis.
GEMINI_API_KEY=
# Opcionales: GEMINI_MODELO=gemini-3.1-flash-image · GEMINI_TAMANO=2K (1K sale ~35% más barato)
#
# Alternativa: FLUX (Black Forest Labs), https://dashboard.bfl.ai
# Se activa con PROVEEDOR_IMAGEN=flux y es el único que admite semilla, o sea el
# único con el que se puede regenerar un fondo idéntico.
BFL_API_KEY=
# Opcionales: BFL_MODELO=flux-2-pro-preview
PROVEEDOR_IMAGEN=

# WhatsApp Cloud API (Meta). El webhook vive en /api/webhooks/whatsapp.
#   PHONE_NUMBER_ID y BUSINESS_ACCOUNT_ID: identificadores, no secretos.
#   TOKEN: Bearer de la app de Meta. El de prueba dura 24 h; el de producción
#     sale de un usuario del sistema y no expira.
#   APP_SECRET: firma cada webhook entrante. Sin esto TODO mensaje recibe 401
#     y WhatsApp deja de funcionar sin ningún error visible.
#   VERIFY_TOKEN: lo inventas tú y lo pegas igual en el panel de Meta.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Opcional: WHATSAPP_API_VERSION=v21.0

